---
import "../styles/global.css";
import TwinCharacter from "../components/TwinCharacter.astro";
import Rocket from "../components/Rocket.astro";

const STAR_COUNT = 120;
const stars = Array.from({ length: STAR_COUNT }, () => ({
  top: Math.random() * 100,
  left: Math.random() * 100,
  size: (Math.random() * 1.6 + 1).toFixed(2),
  delay: (Math.random() * 6).toFixed(2),
  duration: (Math.random() * 3 + 3).toFixed(2),
}));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Time is Trippy — A Story of Relativity</title>
  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        <a href="#screen-start" data-action="restart">Restart</a>
      </nav>
    </header>

    <div class="stars" aria-hidden="true">
      {
        stars.map((star) => (
          <span
            class="star"
            style={`--top:${star.top}%; --left:${star.left}%; --size:${star.size}px; --delay:${star.delay}s; --duration:${star.duration}s;`}
          />
        ))
      }
    </div>

    <main id="app">
      <section id="screen-start" class="screen" data-screen="start">
        <h1 tabindex="-1">Time is <span class="glitch" data-text="Trippy">Trippy</span></h1>
        <p class="tagline">A visual, interactive story about the theory of relativity.</p>
        <button id="start-button" class="start-button" type="button">Start</button>
      </section>

      <section id="screen-intro" class="screen" data-screen="intro" hidden>
        <h2 tabindex="-1">Meet the twins.</h2>
        <div class="twins">
          <TwinCharacter label="The twin who stays" shirtColor="#8ab4ff" />
          <TwinCharacter label="The twin who goes" suited />
        </div>
        <p>What if one of you could travel near the speed of light?</p>
        <button id="choice-button" class="start-button" type="button">Find out</button>
      </section>

      <section id="screen-choice" class="screen" data-screen="choice" hidden>
        <h2 tabindex="-1">Choose a path</h2>
        <p class="tagline">Speed bends time too. Follow the twin who goes.</p>
        <button id="special-relativity-button" class="start-button" type="button">
          Special Relativity
        </button>
      </section>

      <section id="screen-launch" class="screen screen-launch" data-screen="launch" hidden>
        <h2 tabindex="-1" class="sr-only">Launch sequence</h2>
        <div class="launch-ground" id="launch-ground">
          <TwinCharacter label="The twin who stays" shirtColor="#8ab4ff" class="launch-twin-stay" />
          <Rocket class="launch-rocket" />
          <TwinCharacter label="The twin who goes" suited class="launch-twin-go" />
        </div>
        <canvas id="launch-canvas" class="launch-canvas"></canvas>
        <p id="launch-caption" class="launch-caption" aria-live="polite"></p>
        <button id="launch-skip-button" class="skip-button" type="button">Skip</button>
        <p class="texture-credit">Planet &amp; sun imagery: Solar System Scope (CC BY 4.0), NASA</p>
      </section>

      <section id="screen-split" class="screen screen-split" data-screen="split" hidden>
        <h2 tabindex="-1" class="sr-only">Time dilation simulator</h2>
        <div class="split-flash" aria-hidden="true"></div>
        <div class="split-grid">
          <div class="split-pane split-pane-earth" data-age-stage="young" id="split-earth-pane">
            <div class="split-sky" aria-hidden="true"></div>
            <div class="split-ground" aria-hidden="true"></div>
            <p class="split-age-counter" id="split-earth-age">Earth: 0.0 years</p>
            <TwinCharacter label="The twin who stays" shirtColor="#8ab4ff" id="split-earth-twin" />
          </div>
          <div class="split-pane split-pane-ship" data-age-stage="young" id="split-ship-pane">
            <div class="split-window" aria-hidden="true">
              <div class="split-star-streak" id="split-star-streak"></div>
            </div>
            <p class="split-age-counter" id="split-ship-age">Ship: 0.0 years</p>
            <TwinCharacter label="The twin who goes" suited id="split-ship-twin" />
          </div>
        </div>

        <p class="split-formula" id="split-formula" aria-live="off">
          γ = 1 / √(1 − v²/c²) = 1 / √(1 − 0.0000²) = 1.00
        </p>
        <p class="split-math-sentence" id="split-math-sentence" aria-live="off">
          Earth and the ship are ageing at almost the same rate.
        </p>
        <p class="sr-only" id="split-announcer" aria-live="polite"></p>

        <div class="split-controls">
          <label class="split-slider-label" for="split-velocity-slider">Ship speed (fraction of light speed)</label>
          <input
            type="range"
            id="split-velocity-slider"
            class="split-velocity-slider"
            min="0"
            max="9999"
            step="1"
            value="0"
            aria-valuetext="0% of the speed of light"
          />
          <p class="split-rate-hint" id="split-rate-hint">
            Pick how fast the years pass while you watch: each real second you spend on this screen
            advances the simulation by the amount below.
          </p>
          <div class="split-rate-buttons" role="group" aria-label="Simulation speed, in years per real second you spend watching">
            <button type="button" class="split-rate-button" data-rate="1" aria-pressed="true">
              1 real second you watch = 1 year
            </button>
            <button type="button" class="split-rate-button" data-rate="10" aria-pressed="false">
              1 real second you watch = 10 years
            </button>
            <button type="button" class="split-rate-button" data-rate="100" aria-pressed="false">
              1 real second you watch = 100 years
            </button>
          </div>
          <button id="split-play-button" class="start-button" type="button" aria-pressed="false">Play</button>
          <button id="split-bring-home-button" class="start-button" type="button">Bring them home</button>
        </div>
      </section>

      <section id="screen-reunion" class="screen" data-screen="reunion" hidden>
        <h2 tabindex="-1">Reunited</h2>
        <div class="reunion-twins">
          <TwinCharacter label="The twin who stays" shirtColor="#8ab4ff" id="reunion-earth-twin" />
          <TwinCharacter label="The twin who goes" suited id="reunion-ship-twin" />
        </div>
        <p class="reunion-ages" id="reunion-ages">Earth: 0.0 years — Ship: 0.0 years</p>
        <p class="reunion-line">Teleported home instantly — no return trip, no extra time lost.</p>
        <button id="reunion-explain-button" class="start-button" type="button">Why did this happen?</button>
        <a href="#screen-start" class="start-button" data-action="restart">Start over</a>
      </section>

      <section id="screen-explain" class="screen screen-explain" data-screen="explain" hidden>
        <h2 tabindex="-1">Why did they age differently?</h2>
        <p class="explain-text">
          Speed doesn't just carry you through space — it also slows your passage through time. The
          faster the ship travelled, the further its clock fell behind Earth's. That's not a delay in
          the signal or a trick of perspective: close to the speed of light, time itself runs slower
          for the traveller.
        </p>
        <figure class="explain-graph">
          <svg viewBox="0 0 320 200" role="img" aria-labelledby="explain-graph-title explain-graph-desc">
            <title id="explain-graph-title">Time dilation versus ship speed</title>
            <desc id="explain-graph-desc">
              A curve showing the time dilation factor gamma rising with ship speed: it stays near 1 at
              low speed, then climbs steeply as speed approaches the speed of light. A marker shows the
              speed you chose.
            </desc>
            <line class="explain-axis" x1="40" y1="10" x2="40" y2="170" />
            <line class="explain-axis" x1="40" y1="170" x2="300" y2="170" />
            <text class="explain-axis-label" x="40" y="188">0</text>
            <text class="explain-axis-label" x="300" y="188" text-anchor="end">≈c</text>
            <text class="explain-axis-label" x="34" y="174" text-anchor="end">1</text>
            <text class="explain-axis-label" x="34" y="16" text-anchor="end">≈71</text>
            <text class="explain-axis-title" x="170" y="198" text-anchor="middle">Ship speed</text>
            <text class="explain-axis-title" x="14" y="90" text-anchor="middle" transform="rotate(-90 14 90)"
              >γ</text
            >
            <path id="explain-gamma-path" class="explain-gamma-path" />
            <circle id="explain-gamma-point" class="explain-gamma-point" r="5" cx="40" cy="170" />
          </svg>
          <figcaption id="explain-gamma-caption" class="explain-gamma-caption"></figcaption>
        </figure>
        <p class="explain-aside">
          This isn't just a thought experiment: cosmic-ray muons decay in about 2.2 microseconds — only
          enough time to travel ~0.4 miles — but moving near light speed stretches that to ~90
          microseconds from Earth's point of view, long enough to cover the ~16 miles to the ground.
          That's why we detect them at all.
        </p>
        <p class="explain-credit">
          Muon example:
          <a href="https://www.energy.gov/science/doe-explainsrelativity" target="_blank" rel="noopener"
            >U.S. Department of Energy, "DOE Explains...Relativity"</a
          >
        </p>
        <a href="#screen-start" class="start-button" data-action="restart">Start over</a>
      </section>
    </main>

    <div class="music-widget" id="music-widget" data-expanded="false">
      <button
        id="music-toggle"
        class="music-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="music-panel"
        aria-label="Background music"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M12 3a8 8 0 0 0-8 8v6a2 2 0 0 0 2 2h1a1 1 0 0 0 1-1v-5a1 1 0 0 0-1-1H5v-1a7 7 0 0 1 14 0v1h-2a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1h1a2 2 0 0 0 2-2v-6a8 8 0 0 0-8-8Z"
          />
        </svg>
      </button>

      <div class="music-panel" id="music-panel" hidden>
        <div class="music-panel-header">
          <span>Interstellar — Hans Zimmer</span>
          <button id="music-close" class="music-close" type="button" aria-label="Close music player">✕</button>
        </div>
        <div class="music-frame-wrap">
          <iframe
            id="music-iframe"
            title="Interstellar soundtrack by Hans Zimmer, looping background music"
            allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>

    <script src="../scripts/main.ts"></script>
  </body>
</html>
