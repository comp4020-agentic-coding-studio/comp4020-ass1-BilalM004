---
import "../styles/global.css";
import TwinCharacter from "../components/TwinCharacter.astro";

const STAR_COUNT = 120;
const stars = Array.from({ length: STAR_COUNT }, () => ({
  top: Math.random() * 100,
  left: Math.random() * 100,
  size: (Math.random() * 1.6 + 1).toFixed(2),
  delay: (Math.random() * 6).toFixed(2),
  duration: (Math.random() * 3 + 3).toFixed(2),
}));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Time is Trippy — A Story of Relativity</title>
  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        <a href="#screen-start" data-action="restart">Restart</a>
      </nav>
    </header>

    <div class="stars" aria-hidden="true">
      {
        stars.map((star) => (
          <span
            class="star"
            style={`--top:${star.top}%; --left:${star.left}%; --size:${star.size}px; --delay:${star.delay}s; --duration:${star.duration}s;`}
          />
        ))
      }
    </div>

    <main id="app">
      <section id="screen-start" class="screen" data-screen="start">
        <h1 tabindex="-1">Time is <span class="glitch" data-text="Trippy">Trippy</span></h1>
        <p class="tagline">A visual, interactive story about the theory of relativity.</p>
        <button id="start-button" class="start-button" type="button">Start</button>
      </section>

      <section id="screen-intro" class="screen" data-screen="intro" hidden>
        <h2 tabindex="-1">Meet the twins.</h2>
        <div class="twins">
          <TwinCharacter label="The twin who stays" shirtColor="#8ab4ff" />
          <TwinCharacter label="The twin who goes" suited />
        </div>
        <p>What if one of you could travel near the speed of light?</p>
      </section>
    </main>

    <script src="../scripts/main.ts"></script>
  </body>
</html>
